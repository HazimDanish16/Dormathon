# Server configuration. Relative paths resolve from the repository root.
# Set MYMARKET_PROJECT_ROOT when running a non-editable installation.
MYMARKET_CONFIG_DIR=config
MYMARKET_LOG_LEVEL=INFO
MYMARKET_DATABASE_PATH=data/mymarket.sqlite3
MYMARKET_DATA_MODE=real
MYMARKET_DATA_DIR=data/processed
MYMARKET_MODEL_DIR=models
# Keep this revision aligned with Colab's manifest when using E5 features.
MYMARKET_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3

# Optional JSON argument list supplied by the data team. No shell is used.
MYMARKET_PRICE_REFRESH_COMMAND=

# Templates work without credentials. Other providers: gemini, groq, ollama.
LLM_PROVIDER=template
LLM_MODEL=
GEMINI_API_KEY=

# Alternative providers (optional).
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
