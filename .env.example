# Server configuration. Relative paths resolve from the repository root.
# Set MYMARKET_PROJECT_ROOT when running a non-editable installation.
MYMARKET_CONFIG_DIR=config
MYMARKET_LOG_LEVEL=INFO

# Copy to .env and fill values when the explainer is implemented.
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=

# Alternative providers (optional).
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
